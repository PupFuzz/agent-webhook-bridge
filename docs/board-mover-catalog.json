{
  "schema": 1,
  "about": "The bridge's board-mover log catalog: every log row the card-move, park/unpark and writeback code emits carries `catalog_id` in its log context, and every id is an entry here. docs/writeback.md § The board-mover catalog owns the contract; tests/Feature/Writeback/BoardMoverCatalogTest.php checks this file against the source.",
  "context_key": "catalog_id",
  "kinds": {
    "moved": "A card's stage move landed.",
    "written": "A board write other than a stage move landed (create, archive, rename, block_reason, card note, owner-tag clear).",
    "stamped": "Correlation refs were stamped on the card.",
    "stamp_refused": "kanban refused the correlation stamp (4xx).",
    "stamp_declined": "A correlation ref was deliberately not stamped: the card already answers with a different value.",
    "refused": "The write was refused because which card the event names, or whose card it is, is in doubt.",
    "declined": "A guard declined the write by design (pin, parent card, no-regression, add-if-missing, not service-set).",
    "stage_adjusted": "A guard overrode a hold and moved the card anyway (auto-unpark, revive on reopen).",
    "upstream_refused": "kanban or GitHub refused, or did not complete, a call other than the correlation stamp.",
    "upstream_contract": "kanban answered success, but the write it confirmed is not visible.",
    "guard_failopen": "A guard could not read its own input and allowed the write.",
    "partial_read": "A read came back unusable or bounded, so the pass acted on less than the whole answer.",
    "no_correlation": "No card was correlated, so no board write was owed.",
    "token_ruling": "A ruling on which card the event is about, made before any board write.",
    "not_mapped": "Configuration or payload: nothing maps this event, a prerequisite is missing, or the payload is malformed.",
    "config_gap": "The write proceeded, but the install's config lacked something the event asked for.",
    "observability_fault": "A record or signal about a write could not be made; the write decision itself is unaffected.",
    "reported": "A refusal report reached the pull request, or was already there.",
    "pass_summary": "A summary of one pass over several cards."
  },
